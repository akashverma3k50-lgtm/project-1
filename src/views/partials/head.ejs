<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="author" content="<%= content.brand.name %>">
  <meta name="robots" content="index, follow">

  <!-- Instant Dark Theme Initialization (Default: Dark) -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('apex_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- OpenGraph Metadata for Social Previews -->
  <meta property="og:site_name" content="<%= content.brand.name %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= content.seo.ogImage %>">

  <!-- Twitter Card Metadata -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:site" content="<%= content.seo.twitterHandle %>">

  <!-- Favicon / Brand Icon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><polygon points='50,10 90,90 10,90' fill='%230284c7'/></svg>">

  <!-- Google Fonts: Plus Jakarta Sans for Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Modern Responsive Stylesheet with High Performance Cache Control -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Structured Data JSON-LD Schema (Lightweight SEO) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "<%= content.brand.name %>",
    "description": "<%= content.seo.defaultDescription %>",
    "url": "<%= content.seo.siteUrl %>",
    "telephone": "<%= content.brand.phone %>",
    "email": "<%= content.brand.email %>",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "<%= content.brand.location %>"
    }
  }
  </script>
</head>
<body>
