# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Security Secrets (Must be at least 32 characters in production)
SESSION_SECRET=enterprise_session_secret_change_in_production_min_32_chars!
CSRF_SECRET=enterprise_csrf_secret_change_in_production_min_32_chars!

# CORS and Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5

# SMTP / Email Alerts (Optional in dev, logs to console if omitted)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFICATION_EMAIL=inquiries@example.com

# Database Path
DB_PATH=./data/app.db
